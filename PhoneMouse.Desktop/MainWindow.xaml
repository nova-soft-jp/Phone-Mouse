<ui:FluentWindow x:Class="PhoneMouse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Phone-Mouse" Icon="pack://application:,,,/PhoneMouse;component/assets/phone_mouse.ico" Width="900" Height="640" MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource MainText}">
    <Grid Background="{DynamicResource AppBackground}">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
      <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Phone-Mouse" ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                   Background="{DynamicResource AppBackground}" Foreground="{DynamicResource MainText}"
                   ButtonsForeground="{DynamicResource MainText}" ButtonsBackground="{DynamicResource AppBackground}">
        <ui:TitleBar.Header>
          <Button x:Name="MenuButton" Content="☰" Click="MenuToggle_Click" Width="42" Height="38" FontSize="20" Style="{StaticResource MenuNavigationButton}" ToolTip="メニューを開く"/>
        </ui:TitleBar.Header>
      </ui:TitleBar>
      <Grid Grid.Row="1" ClipToBounds="True" Background="{DynamicResource AppBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="28,24,28,28">
            <Grid x:Name="HomeView" Visibility="Visible">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="スマホをタッチパッドに" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="QRコードを読み取ると、スマホからPCのマウスやキーボードを操作できます。" FontSize="14" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                  <StackPanel>
                    <TextBlock Text="接続手順" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="1　PCとスマホを同じWi-Fiに接続" Margin="0,4" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Text="2　スマホのカメラで右のQRを読み取る" Margin="0,4" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Text="3　表示されたページを開いて操作開始" Margin="0,4" Foreground="{DynamicResource SecondaryText}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="14" Padding="18" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#F05252" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="未接続" Foreground="#F87171"/>
                    <Canvas Width="24" Height="21" Margin="8,0,0,0" AutomationProperties.Name="通信状態">
                      <Path x:Name="SignalBar1" Data="M 9,13 A 4.25,4.25 0 0 1 15,13" Stroke="{DynamicResource MainText}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                      <Path x:Name="SignalBar2" Data="M 5.5,9.5 A 9.2,9.2 0 0 1 18.5,9.5" Stroke="{DynamicResource MainText}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                      <Path x:Name="SignalBar3" Data="M 2,6 A 14.2,14.2 0 0 1 22,6" Stroke="{DynamicResource MainText}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                      <Ellipse Canvas.Left="10.5" Canvas.Top="15" Width="3" Height="3" Fill="{DynamicResource MainText}"/>
                    </Canvas>
                  </StackPanel>
                  <TextBlock Text="カメラでQRコードを読み取ります" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,12" HorizontalAlignment="Center"/>
                  <Border Background="White" Padding="8" CornerRadius="5"><Image x:Name="QrImage" Width="190" Height="190"/></Border>
                  <TextBlock Text="PCの接続先" FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="AddressText" Text="準備中…" Foreground="{DynamicResource MainText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0"/>
                  <TextBlock x:Name="ConnectionStageText" Text="① QRコード表示中。スマホで読み取ってください" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,6,0,0"/>
                  <TextBlock x:Name="UrlText" Text="準備中…" Foreground="#1688E8" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,8"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="QRを更新" Style="{StaticResource PrimaryActionButton}" Click="RefreshQr_Click" Margin="0,0,8,0"/>
                    <Button Content="URLをコピー" Style="{StaticResource FlatActionButton}" Click="CopyUrl_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="ConnectionHint" Text="PCとスマホを同じWi-Fiに接続してください" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel x:Name="DetailView" Visibility="Collapsed" MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <TextBlock x:Name="DetailText" FontSize="15" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" LineHeight="28"/>
            </StackPanel>
            <StackPanel x:Name="SettingsView" Visibility="Collapsed" MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="設定" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="アプリ画面の色を選べます。" FontSize="15" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,20"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="DarkThemeButton" Content="ダーク" Style="{StaticResource FlatActionButton}" Click="DarkTheme_Click" Margin="0,0,10,0"/>
                <Button x:Name="LightThemeButton" Content="ライト" Style="{StaticResource FlatActionButton}" Click="LightTheme_Click"/>
              </StackPanel>
              <TextBlock x:Name="ThemeStatus" Text="現在：ダーク" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,14,0,0"/>
              <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,28,0,0">
                <StackPanel>
                  <CheckBox x:Name="AutoStartCheck" Content="PC起動時にPhone-Mouseを自動で起動" FontSize="15" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                  <TextBlock x:Name="AutoStartStatus" Text="Windowsにサインインしたときに起動します。このアプリの保存場所を変更すると自動起動できなくなるため、起動後は同じ場所で使ってください。" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="24,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="通知" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                  <CheckBox x:Name="NotifyConnectionCheck" Content="接続完了を通知" IsChecked="True" Margin="0,4" Checked="NotificationPreference_Changed" Unchecked="NotificationPreference_Changed"/>
                  <CheckBox x:Name="NotifyDisconnectCheck" Content="接続解除を通知" IsChecked="True" Margin="0,4" Checked="NotificationPreference_Changed" Unchecked="NotificationPreference_Changed"/>
                  <CheckBox x:Name="NotifyErrorCheck" Content="エラーを通知" IsChecked="True" Margin="0,4" Checked="NotificationPreference_Changed" Unchecked="NotificationPreference_Changed"/>
                  <TextBlock Text="チェックを外すと、その通知を表示しません。設定は次回起動後も保存されます。" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Border x:Name="MenuScrim" Background="#88000000" Visibility="Collapsed" Opacity="0" MouseDown="MenuScrim_MouseDown" Panel.ZIndex="5"/>
        <Border x:Name="NavigationDrawer" Width="270" HorizontalAlignment="Left" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0" Panel.ZIndex="6" RenderTransformOrigin="0,0.5">
          <Border.RenderTransform><TranslateTransform X="-280"/></Border.RenderTransform>
          <DockPanel Margin="14,18">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="メニュー" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,14"/>
              <Button Content="⌂   ホーム" Tag="home" Click="Nav_Click" Style="{StaticResource MenuNavigationButton}"/>
              <Button Content="▣   接続ガイド" Tag="guide" Click="Nav_Click" Style="{StaticResource MenuNavigationButton}"/>
              <Button Content="⌖   操作方法" Tag="controls" Click="Nav_Click" Style="{StaticResource MenuNavigationButton}"/>
              <Button Content="⚙   設定" Tag="settings" Click="Nav_Click" Style="{StaticResource MenuNavigationButton}"/>
              <Button Content="ⓘ   ウィンドウと終了" Tag="window" Click="Nav_Click" Style="{StaticResource MenuNavigationButton}"/>
              <Button Content="!   接続できないとき" Tag="trouble" Click="Nav_Click" Style="{StaticResource MenuNavigationButton}"/>
              <Button Content="🐞   不具合を報告" Tag="report" Click="Nav_Click" Style="{StaticResource MenuNavigationButton}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,4">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Ellipse x:Name="MenuStatusDot" Width="9" Height="9" Fill="#F05252"/><TextBlock x:Name="MenuStatusText" Text="未接続" Margin="8,-3,0,0" Foreground="#F87171"/></StackPanel>
              <TextBlock Text="同じWi-Fiに接続して使います" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
</ui:FluentWindow>
