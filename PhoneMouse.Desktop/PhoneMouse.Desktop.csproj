<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PhoneMouse</AssemblyName>
    <Version>1.0.2</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\assets\phone_mouse.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="..\index.html" Link="index.html" LogicalName="PhoneMouse.Desktop.index.html" />
    <Resource Include="..\assets\phone_mouse.ico" Link="assets\phone_mouse.ico" />
    <EmbeddedResource Include="..\assets\phone_mouse.png" Link="assets\phone_mouse.png" LogicalName="PhoneMouse.Desktop.assets.phone_mouse.png" />
    <EmbeddedResource Include="..\assets\favicon.ico" Link="assets\favicon.ico" LogicalName="PhoneMouse.Desktop.assets.favicon.ico" />
    <EmbeddedResource Include="..\assets\apple-touch-icon.png" Link="assets\apple-touch-icon.png" LogicalName="PhoneMouse.Desktop.assets.apple-touch-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
